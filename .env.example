# Production: a managed PostgreSQL connection supplied by your Vercel integration.
# npm run setup:local creates a separate, ignored SQLite database for development.
DATABASE_URL=
# Optional direct PostgreSQL connection for migrations when using a pooler.
DIRECT_URL=

# Set to the deployed site origin in Vercel. setup:local supplies the local origin.
NEXTAUTH_URL=
# Generate a unique authentication secret for each environment.
NEXTAUTH_SECRET=

# Optional sign-in providers. Both fields must be set to enable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional PayPal sandbox credentials. Without them checkout creates unpaid demo orders.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Used only by the explicit admin provisioning command, never by public registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
